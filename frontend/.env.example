# URL của Django REST API (đã gồm version)
VITE_API_URL=http://localhost:8000/api/v1

# true: dùng dữ liệu & AI giả lập (chưa cần backend); false: gọi API thật
VITE_USE_MOCK=true

# Bật nhóm chức năng khi backend đã hỗ trợ. Bỏ trống = bật ở chế độ mock, tắt khi gọi API thật.
# Giai đoạn 1 backend mới có chức năng Nhà tuyển dụng nên để trống (hoặc false).
# VITE_FEATURE_AI=false
# VITE_FEATURE_CANDIDATE=false
